{
  "name": "discrete-sim",
  "version": "0.1.19",
  "description": "Discrete-event simulation library for JavaScript/TypeScript",
  "keywords": [
    "simulation",
    "discrete-event",
    "modeling",
    "operations-research",
    "queuing-theory",
    "simpy",
    "warehouse",
    "optimization"
  ],
  "author": "Anes Mulalic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anesask/discrete-sim.git"
  },
  "bugs": {
    "url": "https://github.com/anesask/discrete-sim/issues"
  },
  "homepage": "https://www.discrete-sim.dev",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "lint:fix": "eslint src tests --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
